class Solution {
public:
    long long findMaximumElegance(vector<vector<int>>& items, int k) 
    {
        sort(items.rbegin(), items.rend());
        stack<int> minAtTop;
        unordered_set<int> s;
        long long sum = 0;
        for(int i=0;i<k;i++)
        {
            sum += items[i][0];
            if(s.count(items[i][1])) minAtTop.push(items[i][0]);
            else s.insert(items[i][1]);
        }
        long long ans = sum + s.size()*1LL*s.size();
        for(int i=k;i<items.size();i++)
        {
            if(!s.count(items[i][1]) && !minAtTop.empty())
            {
                s.insert(items[i][1]);
                sum -= minAtTop.top();
                minAtTop.pop();
                sum += items[i][0];
                int n = s.size();
                ans = max(ans, sum + n*1LL*n);
            }
        }
        return ans;
    }
};
